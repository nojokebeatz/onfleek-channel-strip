{
  "name": "onfleek-channel-strip",
  "productName": "OnFleek Channel Strip",
  "version": "1.1.0",
  "description": "SSL-style vocal channel strip for your USB microphone (gate/expander, compressor, 4-band EQ, filters, fader)",
  "main": "src/main.js",
  "author": "OnFleek",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/dsp-test.js",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "live.onfleek.channelstrip",
    "productName": "OnFleek Channel Strip",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "OnFleek-Channel-Strip-Setup-${version}.exe",
      "shortcutName": "OnFleek Channel Strip"
    },
    "portable": {
      "artifactName": "OnFleek-Channel-Strip-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
